# Mi Finanza MVP — variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# Todas las variables tienen default seguro en app/core/config.py.

# ── Entorno ──────────────────────────────────────────────────────────
ENVIRONMENT=dev
DATABASE_URL=sqlite:///./mi_finanza.db

# ── Broker IOL ───────────────────────────────────────────────────────
# mock = sin red | sandbox = sandbox oficial IOL (URL/credenciales propias)
# | real = API real de IOL. Ver docs/IOL_EXECUTION_READINESS.md.
BROKER_MODE=mock
# Ambientes explícitos (sandbox y real NUNCA comparten credenciales).
# Real usa como fallback los legacy IOL_USERNAME/IOL_PASSWORD de abajo.
IOL_REAL_API_BASE=https://api.invertironline.com
IOL_REAL_USERNAME=
IOL_REAL_PASSWORD=
# URL del sandbox oficial de IOL (no documentada acá — obtenerla de IOL).
# Vacía = sandbox bloqueado (fail closed).
IOL_SANDBOX_API_BASE=
IOL_SANDBOX_USERNAME=
IOL_SANDBOX_PASSWORD=
# Lock propio de órdenes simuladas en sandbox.
SANDBOX_EXECUTION_ENABLED=false
# ── Política de orden IOL (vacío/0 = ejecución bloqueada) ────────────
IOL_ORDER_MARKET=
IOL_ORDER_SETTLEMENT=
IOL_ORDER_TYPE=precioLimite
IOL_ORDER_VALIDITY_MINUTES=10
EXECUTION_MAX_QUOTE_AGE_SECONDS=15
EXECUTION_MAX_PRICE_DEVIATION_PCT=0
# Safety lock: con broker real, approve NO envía órdenes salvo que esto
# sea true explícito. Default false (fail closed). No afecta modo mock.
ORDER_EXECUTION_ENABLED=false

# ── Execution Authorization V1 (todo fail-closed) ────────────────────
# Credencial secundaria para ejecutar (header X-Execution-Key).
# Vacía = ejecución real imposible. NUNCA ponerla en el frontend.
EXECUTION_ADMIN_KEY=
# Secreto HMAC para firmar previews. Vacío = ejecución real imposible.
EXECUTION_PREVIEW_SECRET=
# Vigencia del preview firmado (segundos, > 0).
EXECUTION_PREVIEW_TTL_SECONDS=300
# Antigüedad máxima de una recomendación ejecutable (minutos, > 0).
EXECUTION_MAX_RECOMMENDATION_AGE_MINUTES=60
# Límites duros. 0 = NO configurado = ejecución real bloqueada (no "sin límite").
EXECUTION_MAX_ORDER_VALUE=0
EXECUTION_MAX_TOTAL_VALUE=0
EXECUTION_MAX_PORTFOLIO_PCT=0
IOL_USERNAME=
IOL_PASSWORD=
IOL_PORTFOLIO_COUNTRY=argentina
IOL_TIMEOUT_SECONDS=15

# ── Noticias ─────────────────────────────────────────────────────────
# mock | rss
NEWS_PROVIDER=rss
NEWS_TIMEOUT_SECONDS=10
NEWS_MAX_ITEMS=20

# ── Scheduler (horas en UTC; BYMA: 11=08:00 ART, 20=17:00 ART) ──────
SCHEDULER_ENABLED=true
SCHEDULER_MARKET_OPEN_HOUR=11
SCHEDULER_MARKET_CLOSE_HOUR=20
SCHEDULER_OPEN_INTERVAL_MINUTES=30
SCHEDULER_POSTMARKET_FORCE_CYCLE=false

# ── Perfil de inversor ───────────────────────────────────────────────
# conservative | moderate | moderate_aggressive | aggressive
INVESTOR_PROFILE_TARGET=moderate_aggressive
MAX_MOVEMENT_PER_CYCLE=0.10

# ── LLM (GPT) — solo explica, nunca decide ni ejecuta ───────────────
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15

# ── Notificaciones ───────────────────────────────────────────────────
NOTIFICATION_ENABLED=true
# telegram | web_push
NOTIFICATION_CHANNEL=web_push
NOTIFICATION_MIN_SEVERITY=medium
NOTIFICATION_COOLDOWN_SECONDS=300
NOTIFICATION_CONTRADICTION_THRESHOLD=3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Web Push (generar con: npx web-push generate-vapid-keys) ────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# ── Pipeline ─────────────────────────────────────────────────────────
USE_CLUSTERS=false

# ── Seguridad ────────────────────────────────────────────────────────
# API key para endpoints sensibles (approve/reject/settings/debug).
# Vacío = sin autenticación (solo dev local).
API_KEY=
# CORS origins (CSV). "*" = permitir todo (solo dev).
CORS_ORIGINS=*

# ── Debug ────────────────────────────────────────────────────────────
# Deshabilitar en producción: bloquea POST /debug/simulate-alert con 403.
DEBUG_ENDPOINTS_ENABLED=true

# ── Universo de activos (CSV) ────────────────────────────────────────
WHITELIST_ASSETS=AAPL,MSFT,SPY,QQQ,AL30,BND,CASH
WATCHLIST_ASSETS=
MARKET_UNIVERSE_ASSETS=
