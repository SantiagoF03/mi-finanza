# Mi Finanza — configuración del motor de ejecución semiautomática
#
# Copiá lo que necesites a backend/.env. TODO es fail-closed: una variable
# vacía o en 0 BLOQUEA, nunca significa "sin límite".
#
# NUNCA pongas credenciales reales en un archivo versionado.

# ───────────────────────────────────────────────────────────────────
# Candado global — por encima de todo lo demás
# ───────────────────────────────────────────────────────────────────
ORDER_EXECUTION_ENABLED=false
SANDBOX_EXECUTION_ENABLED=false

# ───────────────────────────────────────────────────────────────────
# Capacidades — independientes, todas apagadas por defecto
# ───────────────────────────────────────────────────────────────────
# Ninguna alcanza por sí sola: además hace falta ORDER_EXECUTION_ENABLED,
# catálogo verificado, política de clase y mercado abierto.
SECURITIES_BUY_ENABLED=false
SECURITIES_SELL_ENABLED=false

# Cancelación real: DELETE /api/v2/operaciones/{numero}. Capacidad PROPIA —
# poder enviar una orden no dice nada sobre poder cancelarla. Un único DELETE
# por decisión humana, sin reintento automático.
ORDER_CANCELLATION_ENABLED=false

# FCI: familia separada, con endpoints y contrato oficiales.
#   POST /api/v2/operar/suscripcion/fci   Simbolo, Monto, soloValidar
#   POST /api/v2/operar/rescate/fci       Simbolo, Monto, soloValidar
#   GET  /api/v2/Titulos/FCI
# form-urlencoded. El RESCATE también se expresa por Monto: no hay campo
# oficial para cuotapartes y no se inventa ninguno.
#
# Suscripción y rescate son capacidades INDEPENDIENTES: poder poner plata en
# un fondo no dice nada sobre poder sacarla, y al revés.
#
# Encender estos flags no alcanza: además hacen falta ORDER_EXECUTION_ENABLED,
# fondo verificado, validación soloValidar fresca, preview firmado, saldo o
# tenencia en vivo y los límites de acá abajo. Ver docs/IOL_FCI_CAPABILITY.md
FCI_SUBSCRIPTION_ENABLED=false
FCI_REDEMPTION_ENABLED=false

# Frescura de la validación previa. Una validación vieja no autoriza un envío:
# entre medio cambian el valor de cuotaparte, el saldo y el cutoff. Además, el
# hash del payload validado tiene que coincidir con el que se envía — cambiar
# el monto obliga a revalidar.
FCI_VALIDATION_TTL_SECONDS=120

# Límites propios de FCI — 0 = NO CONFIGURADO = bloqueado, nunca "sin límite".
# No se comparten con los de títulos: un fondo no se dimensiona igual que una
# acción.
FCI_MAX_OPERATION_AMOUNT=0
FCI_MAX_DAILY_AMOUNT=0

# Colchón sobre el monto para comisiones/impuestos, y efectivo que nunca se
# toca. Ambos aplican a la SUSCRIPCIÓN, contra el saldo vivo.
FCI_FEE_BUFFER_PCT=0
FCI_MIN_CASH_RESERVE=0

# DEPRECADO. Mientras esté en true sigue bloqueando TODA compra y sigue
# autorizando el camino legacy de venta (compatibilidad con la config
# productiva actual). Migración: SECURITIES_SELL_ENABLED=true y luego
# EXECUTION_SELL_ONLY=false.
EXECUTION_SELL_ONLY=true

# ───────────────────────────────────────────────────────────────────
# Guards en vivo — no se pueden desactivar para sandbox/real
# ───────────────────────────────────────────────────────────────────
EXECUTION_REQUIRE_LIVE_POSITION_CHECK=true
EXECUTION_REQUIRE_LIVE_CASH_CHECK=true

# ───────────────────────────────────────────────────────────────────
# Políticas por clase (ACCIONES | CEDEARS | FCI) — JSON
# ───────────────────────────────────────────────────────────────────
# Esto es lo que reemplaza escribir una política por cada símbolo: una clase
# cubre todos sus instrumentos. TODOS los campos son obligatorios; falta uno
# y la clase entera queda inválida (class_policy_incomplete).
#
# EXECUTION_CLASS_POLICIES={"ACCIONES":{"buy_enabled":true,"sell_enabled":true,"currencies":["ARS"],"markets":["bCBA"],"settlements":["t1"],"max_order_notional":500,"max_daily_notional":2000,"max_quantity":10,"max_portfolio_pct":0.02,"min_cash_reserve":1000,"fee_buffer_pct":0.01,"max_quote_age_seconds":15,"max_price_deviation_pct":0.02,"catalog_max_age_seconds":86400,"validity_minutes":10,"default_quantity_step":1,"default_price_tick":0.01,"order_type":"precioLimite"},"CEDEARS":{"buy_enabled":true,"sell_enabled":true,"currencies":["ARS"],"markets":["bCBA"],"settlements":["t1"],"max_order_notional":500,"max_daily_notional":2000,"max_quantity":10,"max_portfolio_pct":0.02,"min_cash_reserve":1000,"fee_buffer_pct":0.01,"max_quote_age_seconds":15,"max_price_deviation_pct":0.02,"catalog_max_age_seconds":86400,"validity_minutes":10,"default_quantity_step":1,"default_price_tick":0.01,"order_type":"precioLimite"}}
EXECUTION_CLASS_POLICIES={}

# Overrides por símbolo. SOLO pueden ENDURECER: bajar un límite, apagar un
# lado, subir la reserva/buffer. Intentar aflojar → override_increases_limit
# y se conserva el valor de la clase.
# EXECUTION_INSTRUMENT_OVERRIDES={"BYMA":{"max_order_notional":300,"buy_enabled":false}}
EXECUTION_INSTRUMENT_OVERRIDES={}

# Identidad numérica que NO se puede derivar de datos read-only: la
# "alteración mínima" de IOL y el lote. Nunca identidad (moneda/mercado).
# EXECUTION_INSTRUMENT_TICKS={"BYMA":{"price_tick":1,"quantity_step":1}}
EXECUTION_INSTRUMENT_TICKS={}

# Símbolos que nunca se operan, gane quien gane. Siempre tiene la última
# palabra: ni un override ni el escape administrativo lo levantan.
EXECUTION_DENYLIST=

# Escape administrativo explícito para que un override PUEDA ampliar un
# límite. Default false: sin esto, ningún override amplía nada.
EXECUTION_ALLOW_OVERRIDE_LIMIT_INCREASE=false

# ───────────────────────────────────────────────────────────────────
# Allowlist legacy por símbolo — sigue funcionando
# ───────────────────────────────────────────────────────────────────
# Cuando un símbolo tiene política legacy, ESA manda para ese símbolo. El
# resto pasa por catálogo + política de clase.
EXECUTION_INSTRUMENT_POLICIES={}

# ───────────────────────────────────────────────────────────────────
# Límites globales — 0 = NO CONFIGURADO = bloqueado
# ───────────────────────────────────────────────────────────────────
EXECUTION_MAX_ORDER_VALUE=0
EXECUTION_MAX_TOTAL_VALUE=0
EXECUTION_MAX_PORTFOLIO_PCT=0

# ───────────────────────────────────────────────────────────────────
# Autorización de ejecución
# ───────────────────────────────────────────────────────────────────
EXECUTION_ADMIN_KEY=
EXECUTION_PREVIEW_SECRET=
EXECUTION_PREVIEW_TTL_SECONDS=300
EXECUTION_MAX_RECOMMENDATION_AGE_MINUTES=60

# ───────────────────────────────────────────────────────────────────
# Política de orden IOL
# ───────────────────────────────────────────────────────────────────
IOL_ORDER_MARKET=
IOL_ORDER_SETTLEMENT=
IOL_ORDER_TYPE=precioLimite
IOL_ORDER_VALIDITY_MINUTES=10
EXECUTION_MAX_QUOTE_AGE_SECONDS=15
EXECUTION_MAX_PRICE_DEVIATION_PCT=0
EXECUTION_QUOTE_CLOCK_SKEW_SECONDS=2

# ───────────────────────────────────────────────────────────────────
# Calendario y horarios — MINUTOS, no sólo horas
# ───────────────────────────────────────────────────────────────────
# PREFERIDO: HH:MM interpretado en SCHEDULER_TIMEZONE. Es la única forma de
# representar la apertura real de BYMA (10:30).
SCHEDULER_MARKET_OPEN_TIME=10:30
SCHEDULER_MARKET_CLOSE_TIME=17:00
SCHEDULER_TIMEZONE=America/Argentina/Buenos_Aires

# DEPRECADO: sólo horas enteras, no puede representar 10:30. Se ignora en
# cuanto las variables HH:MM están presentes.
# SCHEDULER_MARKET_OPEN_HOUR=11
# SCHEDULER_MARKET_CLOSE_HOUR=20

# Días no hábiles, "YYYY-MM-DD" separados por coma. Una entrada mal formada
# invalida TODO el calendario (market_schedule_unknown) en vez de declarar
# abierto un día cerrado.
MARKET_HOLIDAYS=

# ───────────────────────────────────────────────────────────────────
# Entornos de broker — sandbox y real nunca comparten credenciales
# ───────────────────────────────────────────────────────────────────
BROKER_MODE=mock
IOL_REAL_API_BASE=https://api.invertironline.com
IOL_REAL_USERNAME=
IOL_REAL_PASSWORD=
# La URL oficial del sandbox NO está documentada acá. No se adivina.
IOL_SANDBOX_API_BASE=
IOL_SANDBOX_USERNAME=
IOL_SANDBOX_PASSWORD=
